# Copy this file to .env and fill in your X cookies from DevTools.

X_CT0=
X_AUTH_TOKEN=

# API key for protecting API routes in production.
# If set, all API requests must include an X-Api-Key header.
# If not set, API access is restricted to localhost only.
X_API_KEY=

# Optional overrides
# X_BOOKMARKS_JSONL=
# FT_DATA_DIR=
# X_OUTPUT_DIR=data/output
# X_BOOKMARKS_OUTPUT=data/output/bookmarks-data.json
# X_FOLDERS_OUTPUT=data/output/folders-data.json
